{
  "manifest_version": 3,
  "name": "BoldVoice Vowel Focus Reader",
  "version": "1.10.0",
  "description": "Adds exhaustive guided vowel training, progress analysis, and pronunciation games to the BoldVoice vowel map.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://boldvoice.com/*",
    "https://vowel-chart-experiment.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://boldvoice.com/*",
        "https://vowel-chart-experiment.onrender.com/*"
      ],
      "js": [
        "src/page-detector.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://boldvoice.com/*",
        "https://vowel-chart-experiment.onrender.com/*"
      ],
      "js": [
        "src/training-data.js",
        "src/training-core.js",
        "src/content.js",
        "src/guided-training.js"
      ],
      "css": [
        "src/styles.css",
        "src/guided-styles.css"
      ],
      "run_at": "document_start"
    }
  ]
}
