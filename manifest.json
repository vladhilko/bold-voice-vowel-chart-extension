{
  "manifest_version": 3,
  "name": "BoldVoice Vowel Progress Coach",
  "version": "1.11.3",
  "description": "Unofficial guided vowel training and progress tools for the BoldVoice vowel map.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://boldvoice.com/games/vowel-map*"
      ],
      "js": [
        "src/page-detector.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://boldvoice.com/games/vowel-map*"
      ],
      "js": [
        "src/training-data.js",
        "src/training-core.js",
        "src/content.js",
        "src/guided-training.js"
      ],
      "css": [
        "src/styles.css",
        "src/guided-styles.css"
      ],
      "run_at": "document_start"
    }
  ]
}
